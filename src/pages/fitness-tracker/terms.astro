---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkipLink from '../../components/SkipLink.astro';
import SupportSiteHeader from '../../components/SupportSiteHeader.astro';
import SupportLegalFooter from '../../components/SupportLegalFooter.astro';
import { APP_SUPPORT } from '../../lib/app-support';

const title = `Terms of Use — ${APP_SUPPORT.appName} | ${APP_SUPPORT.company}`;
const description = `Terms of use for the ${APP_SUPPORT.appName} mobile app by ${APP_SUPPORT.company}.`;
const lastUpdated = '2026-06-07';
---

<BaseLayout title={title} description={description} lang="en">
  <SkipLink />
  <SupportSiteHeader lang="en" />

  <main id="main" class="support-page legal-page">
    <article class="container legal-article">
      <header class="legal-header">
        <p class="support-eyebrow">{APP_SUPPORT.appName} · {APP_SUPPORT.company}</p>
        <h1>Terms of Use</h1>
        <p class="legal-updated">Last updated: {lastUpdated}</p>
      </header>

      <p>
        These Terms of Use ("Terms") govern your use of the <strong>{APP_SUPPORT.appName}</strong> mobile application
        provided by {APP_SUPPORT.company} ("we", "us"). By using the app, you agree to these Terms.
      </p>

      <h2>The service</h2>
      <p>
        {APP_SUPPORT.appName} is a strength training and workout logging app for iPhone and iPad. Features include
        logging workouts, plans and templates, progress tracking, and user accounts. The current release is provided
        free of charge with no active in-app subscriptions.
      </p>

      <h2>Your account</h2>
      <p>
        You are responsible for maintaining the confidentiality of your login credentials and for activity under your
        account. You may delete your account at any time via
        <strong>Profile → Settings → Account & Security → Delete account</strong>.
      </p>

      <h2>Acceptable use</h2>
      <p>
        You agree not to misuse the app, attempt unauthorized access to our systems, or use the service in violation of
        applicable law.
      </p>

      <h2>Health and fitness disclaimer</h2>
      <p>
        {APP_SUPPORT.appName} is a training log and planning tool, not medical advice. Consult a qualified professional
        before starting or changing an exercise program. You use the app at your own risk.
      </p>

      <h2>Data and privacy</h2>
      <p>
        Our collection and use of personal data is described in our
        <a href={APP_SUPPORT.privacyPath}>Privacy Policy</a>. The app does not use Apple Health or HealthKit.
      </p>

      <h2>Availability and changes</h2>
      <p>
        We may modify, suspend, or discontinue features with reasonable notice where practicable. We may update these
        Terms; continued use after changes constitutes acceptance.
      </p>

      <h2>Limitation of liability</h2>
      <p>
        To the fullest extent permitted by law, {APP_SUPPORT.company} is not liable for indirect, incidental, or
        consequential damages arising from your use of the app.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about these Terms: <a href={`mailto:${APP_SUPPORT.supportEmail}`}>{APP_SUPPORT.supportEmail}</a><br />
        App support: <a href={APP_SUPPORT.supportPath}>{APP_SUPPORT.supportPath}</a>
      </p>
    </article>
  </main>

  <SupportLegalFooter lang="en" />
</BaseLayout>
