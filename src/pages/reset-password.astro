---
import AuthLayout from '../layouts/AuthLayout.astro';
import { MIN_PASSWORD_LENGTH } from '../lib/auth-api';
---

<AuthLayout
  title="Reset password — PushLab"
  description="Choose a new PushLab password. This page is opened from the reset link in your email."
>
  <p class="eyebrow">Account</p>
  <h1>Reset your password</h1>
  <p class="auth-lead" data-auth-missing>
    This link is missing a reset token. Open the latest reset email from PushLab, or request a new one in the app.
  </p>

  <form id="reset-form" class="auth-form" novalidate hidden>
    <p class="auth-lead">Enter a new password, then confirm it. We send it to PushLab over HTTPS together with the token from this link.</p>

    <label class="auth-field">
      <span>New password</span>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength={MIN_PASSWORD_LENGTH}
        required
      />
    </label>

    <label class="auth-field">
      <span>Confirm password</span>
      <input
        id="confirm"
        name="confirm"
        type="password"
        autocomplete="new-password"
        minlength={MIN_PASSWORD_LENGTH}
        required
      />
    </label>

    <p id="reset-error" class="auth-error" role="alert" hidden></p>

    <button type="submit" class="btn btn-primary" id="reset-submit">Update password</button>
  </form>
</AuthLayout>

<script>
  import { MIN_PASSWORD_LENGTH, postAuthJson, readQueryToken } from '../lib/auth-api';

  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const missing = document.querySelector('[data-auth-missing]') as HTMLElement | null;
  const errorEl = document.getElementById('reset-error') as HTMLElement | null;
  const submit = document.getElementById('reset-submit') as HTMLButtonElement | null;
  const token = readQueryToken();

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.hidden = false;
    errorEl.textContent = message;
  }

  if (token) {
    form?.removeAttribute('hidden');
    if (missing) missing.hidden = true;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!token) {
      showError('Invalid or missing reset token.');
      return;
    }

    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirm = (document.getElementById('confirm') as HTMLInputElement).value;

    if (!password || !confirm) {
      showError('Fill both password fields.');
      return;
    }
    if (password !== confirm) {
      showError('Passwords do not match.');
      return;
    }
    if (password.length < MIN_PASSWORD_LENGTH) {
      showError(`Password must be at least ${MIN_PASSWORD_LENGTH} characters.`);
      return;
    }

    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Updating…';
    }
    if (errorEl) errorEl.hidden = true;

    try {
      await postAuthJson('/auth/reset-password', { token, password });
      window.location.assign('/auth/success?kind=reset');
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Could not update password.');
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Update password';
      }
    }
  });
</script>
